# Copy this file to `.env.local` and fill in real values.
# Everything here is OPTIONAL. With no .env.local at all the shop runs in
# ENQUIRY mode: you can browse, add to cart, and the buy button hands the
# customer a pre-filled order email. Nothing to sign up for to click around.

# --- Database (enables order recording + live stock) -------------------------
# Neon Postgres connection string, from https://console.neon.tech
# Project -> Connection Details -> copy the "pooled" connection string.
#
# Use a SEPARATE Neon branch for local development so test orders never touch
# real sales. In the Neon console: Branches -> New Branch -> name it "dev".
#
# After setting this, create the tables:  npm run db:init
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# --- Stripe (enables real checkout) -----------------------------------------
# TEST keys from https://dashboard.stripe.com/test/apikeys
# Swap for live keys (sk_live_...) only when you are ready to take real money.
STRIPE_SECRET_KEY=sk_test_...

# Webhook signing secret. When testing locally, run:
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
# and paste the whsec_... value it prints.
#
# In production this is a DIFFERENT value — create the endpoint at
# https://dashboard.stripe.com/webhooks pointing at
# https://kittenkrafts.com/api/stripe/webhook and copy its signing secret.
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Site --------------------------------------------------------------------
# Absolute origin, used to build Stripe redirect URLs. Get this wrong in
# production and customers get bounced to localhost after paying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Admin dashboard ---------------------------------------------------------
# Enables /admin/orders. Leave unset to disable the page entirely.
# ADMIN_PASSWORD=something-long-and-private

# --- Checkout mode -----------------------------------------------------------
# Normally LEAVE THIS UNSET — the shop works out its own mode from what is
# available (see src/lib/checkout-mode.ts):
#
#   stripe   Stripe keys + DATABASE_URL set   -> real hosted checkout
#   demo     DATABASE_URL, no Stripe          -> fake paid order, stock moves
#   enquiry  no DATABASE_URL                  -> pre-filled order email
#
# Set it only to TEST a mode you would not otherwise hit locally.
#
#   CHECKOUT_MODE=enquiry npm run dev
#
# CHECKOUT_MODE=enquiry
