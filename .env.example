# Copy this file to `.env.local` and fill in real values.
# Everything here is OPTIONAL. With no .env.local at all the shop runs in
# DEMO CHECKOUT mode: orders are recorded and inventory decremented, but no
# money moves. That is the intended way to click through the prototype.

# --- Stripe (enables real checkout) -----------------------------------------
# Test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...

# Webhook signing secret. When testing locally, run:
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
# and paste the whsec_... value it prints.
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Site --------------------------------------------------------------------
# Absolute origin, used to build Stripe redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Checkout mode -----------------------------------------------------------
# Normally LEAVE THIS UNSET — the shop works out its own mode from what is
# available (see src/lib/checkout-mode.ts):
#
#   stripe   Stripe keys are set                    -> real hosted checkout
#   demo     no Stripe, writable database           -> fake paid order, stock moves
#   enquiry  no Stripe, no database (e.g. Vercel)   -> pre-filled order email
#
# Set it only to TEST a mode you would not otherwise hit locally. Forcing
# `enquiry` before you deploy is worth doing — otherwise the first time you see
# production's code path is in production.
#
#   CHECKOUT_MODE=enquiry npm run dev
#
# CHECKOUT_MODE=enquiry

# Where the SQLite file lives. Defaults to ./data/shop.db
# DATABASE_PATH=./data/shop.db
